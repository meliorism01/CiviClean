# CiviClean Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env with production credentials to source control.

# Flask Application Secret Key (generate a secure random key in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection URI (defaults to SQLite if unset)
# SQLite: sqlite:///instance/mapmywaste.db
# PostgreSQL example: postgresql://username:password@localhost:5432/civiclean_db
DATABASE_URL=sqlite:///instance/mapmywaste.db

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1
